# Local environment variables template
# Copy this file to local/.env and fill in your actual values

# Google Maps Platform API Key (works for multiple APIs)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable these APIs in your Google Cloud project:
#   - Elevation API (for elevation data)
#   - Geocoding API (for reverse geocoding)
# Same key works for both APIs - just enable the APIs you need
GOOGLE_ELEVATION_API_KEY=your-google-maps-platform-api-key-here

# OpenAI API Key (if needed for validation agent)
# OPENAI_API_KEY=your-openai-api-key-here

# Weather API Keys for microbiome research comparison
# Note: Open-Meteo requires no API key (free)
# Note: Meteostat is a Python library (no API key needed)
# Note: Google Weather uses Maps Platform (same key as elevation)

# Other API keys can go here as needed