{
  "version": "1.0",
  "created": "2025-09-08",
  "description": "Configuration for crawl-first unified enrichment system (JSON fallback)",
  
  "datasets": {
    "elevation": {
      "copernicus_dem": "/data/elevation/copernicus_dem_30m.tif",
      "usgs_point_service": true
    },
    "land_cover": {
      "worldcover_2021": "/data/land_cover/esa_worldcover_2021_v200.tif",
      "nlcd_2019": "/data/land_cover/nlcd_2019_land_cover_l48_20210604.tif",
      "nlcd_2021": "/data/land_cover/nlcd_2021_land_cover_l48_20230630.tif"
    },
    "soils": {
      "soilgrids_ph": "/data/soils/soilgrids/phh2o_0-5cm_mean.tif",
      "soilgrids_soc": "/data/soils/soilgrids/soc_0-5cm_mean.tif",
      "soilgrids_sand": "/data/soils/soilgrids/sand_0-5cm_mean.tif",
      "soilgrids_silt": "/data/soils/soilgrids/silt_0-5cm_mean.tif",
      "soilgrids_clay": "/data/soils/soilgrids/clay_0-5cm_mean.tif",
      "soilgrids_bdod": "/data/soils/soilgrids/bdod_0-5cm_mean.tif",
      "soilgrids_nitrogen": "/data/soils/soilgrids/nitrogen_0-5cm_mean.tif",
      "soilgrids_ocd": "/data/soils/soilgrids/ocd_0-5cm_mean.tif"
    },
    "coastlines": "/data/coastlines/gshhs/gshhs_c.shp",
    "inland_water": "/data/hydrolakes/HydroLAKES_polys_v10.shp",
    "ecoregions": "/data/ecoregions/wwf_terr_ecos/wwf_terr_ecos.shp"
  },
  
  "providers": {
    "weather": {
      "primary": "open_meteo",
      "secondary": "meteostat",
      "fallback": "prism_us",
      "rate_limit_s": 1.0,
      "timeout_s": 30
    },
    "elevation": {
      "primary": "local_dem",
      "fallback": "usgs_point"
    },
    "land_cover": {
      "primary": "local_cog",
      "fallback": "wms_services"
    },
    "soils": {
      "primary": "local_cog",
      "fallback": "soilgrids_api"
    }
  },
  
  "osm": {
    "default_radius_m": 1000,
    "timeout_s": 180,
    "max_features": 100,
    "overpass_url": "https://overpass-api.de/api/interpreter",
    "retry_attempts": 2,
    "retry_delay_s": 5
  },
  
  "site_typing": {
    "D_open_km": 20,
    "D_inland_km": 0.2,
    "D_coast_km": 2,
    "osm_water_radius_m": 1000
  },
  
  "crosswalks": {
    "envo_mapping": "/mappings/envo_crosswalk.json",
    "usda_texture": true
  },
  
  "sampling": {
    "elevation": {
      "method": "bilinear",
      "window_px": 1
    },
    "land_cover": {
      "method": "nearest",
      "window_px": 1
    },
    "soils": {
      "method": "buffered_median",
      "window_px": 3
    }
  },
  
  "weather": {
    "coverage_threshold": 0.7,
    "quality_flags": [
      "temperature_2m",
      "precipitation",
      "wind_speed_10m", 
      "relative_humidity_2m"
    ],
    "fallback_search_radius_km": 50
  },
  
  "wms": {
    "default_timeout_s": 30,
    "capabilities_cache_hours": 24,
    "supported_versions": ["1.3.0", "1.1.1"],
    "preferred_formats": ["application/json", "text/xml", "image/geotiff"]
  },
  
  "caching": {
    "enable_capabilities_cache": true,
    "cache_duration_hours": 24,
    "max_concurrent_requests": 10
  },
  
  "output": {
    "precision": {
      "distances_km": 3,
      "coordinates": 6,
      "weather_values": 2,
      "soil_values": 2
    },
    "include_debug_info": false,
    "include_raw_responses": false
  },
  
  "error_handling": {
    "max_retries": 3,
    "retry_delay_s": 2,
    "timeout_multiplier": 1.5,
    "fail_fast": false
  },
  
  "logging": {
    "level": "INFO",
    "include_timestamps": true,
    "include_coordinates": true,
    "log_api_calls": true
  }
}